  {
    "id": "fn_threshold",
    "type": "function",
    "z": "flow_api",
    "name": "Auth + Set Threshold",
    "func": "const KEY = env.get('API_KEY') || 'rahasia123';\nmsg.headers = {'Access-Control-Allow-Origin': '*'};\nif (msg.req.headers['x-api-key'] !== KEY) {\n    msg.statusCode = 401;\n    msg.payload = {status: 'error', message: 'API key tidak valid'};\n    return msg;\n}\nconst body = msg.payload || {};\nconst t = Number(body.max_suhu);\nif (body.max_suhu === undefined || body.max_suhu === '' || !isFinite(t)) {\n    msg.statusCode = 400;\n    msg.payload = {status: 'error', message: 'max_suhu wajib berupa angka'};\n    return msg;\n}\nglobal.set('threshold', t);\nmsg.statusCode = 200;\nmsg.payload = {status: 'success', max_suhu: t};\nreturn msg;",
