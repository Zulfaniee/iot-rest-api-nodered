  {
    "id": "store_sensor",
    "type": "function",
    "z": "flow_api",
    "name": "Simpan, Broadcast & Cek Threshold",
    "func": "const data = msg.payload;\nif (typeof data !== 'object' || data === null) { return null; }\ndata.received = new Date().toISOString();\nflow.set('lastSensor', data);\n\n// 1) Kirim ke dashboard via WebSocket\nconst out = {payload: {type: 'sensor', data: data}};\n\n// 2) Simpan ke SQLite (prepared statement)\nconst db = {params: {\n    $suhu: data.suhu,\n    $kelembaban: data.kelembaban,\n    $timestamp: data.timestamp,\n    $received: data.received\n}};\n\n// 3) Cek threshold -> notifikasi\nconst limit = global.get('threshold') ?? 30;\nlet alert = null;\nif (data.suhu > limit) {\n    alert = {\n        topic: 'iot/alert',\n        payload: {type: 'alert', suhu: data.suhu, limit: limit,\n                  message: 'Suhu ' + data.suhu + '°C melebihi batas ' + limit + '°C'}\n    };\n}\nreturn [out, db, alert];",
    "outputs": 3,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 440,
    "y": 80,
    "wires": [
      [
        "ws_out"
      ],
      [
        "sql_insert"
      ],
      [
        "ws_out",
        "mqtt_alert_out",
        "debug_alert"
      ]
    ]
  },
