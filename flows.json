  {
    "id": "fn_kontrol",
    "type": "function",
    "z": "flow_api",
    "name": "Auth + Validasi + Publish",
    "func": "const KEY = env.get('API_KEY') || 'rahasia123';\nmsg.headers = {'Access-Control-Allow-Origin': '*'};\nif (msg.req.headers['x-api-key'] !== KEY) {\n    msg.statusCode = 401;\n    msg.payload = {status: 'error', message: 'API key tidak valid'};\n    return [msg, null];\n}\nconst body = msg.payload || {};\nif (!body.device || !body.action) {\n    msg.statusCode = 400;\n    msg.payload = {status: 'error', message: 'device dan action wajib diisi'};\n    return [msg, null];\n}\nnode.send([null, {topic: 'iot/kontrol', payload: body}]);\nmsg.statusCode = 200;\nmsg.payload = {status: 'success', message: 'Perintah terkirim', sent: body};\nreturn [msg, null];",
