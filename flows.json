    "id": "fn_suhu",
    "type": "function",
    "z": "flow_api",
    "name": "Auth + Data Terakhir",
    "func": "const KEY = env.get('API_KEY') || 'rahasia123';\nmsg.headers = {'Access-Control-Allow-Origin': '*'};\nif (msg.req.headers['x-api-key'] !== KEY) {\n    msg.statusCode = 401;\n    msg.payload = {status: 'error', message: 'API key tidak valid'};\n    return msg;\n}\nconst data = flow.get('lastSensor') || {suhu: null, kelembaban: null, timestamp: null};\nmsg.statusCode = 200;\nmsg.payload = {status: 'success', data: data, server_time: new Date().toISOString()};\nreturn msg;",
